<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#55141619" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#338A8E93" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#AA4A4D52" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#99141619" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#88FFFFFF" />
        </shape>
    </item>
</selector>
