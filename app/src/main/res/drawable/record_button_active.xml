<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#66000000" />
            <stroke android:width="5dp" android:color="@color/pilot_red" />
        </shape>
    </item>
    <item android:left="22dp" android:top="22dp" android:right="22dp" android:bottom="22dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/pilot_red" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
