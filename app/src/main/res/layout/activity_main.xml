<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pilot_black"
    android:orientation="vertical">

    <include layout="@layout/pilot_status_bar" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/preview_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/gps_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:layout_marginStart="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/pilot_chip_background"
            android:drawableStart="@drawable/ic_gps"
            android:drawablePadding="5dp"
            android:gravity="center"
            android:text="@string/gps_waiting"
            android:textColor="@color/pilot_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/record_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="12dp"
            android:background="@drawable/pilot_chip_background"
            android:fontFamily="monospace"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="00:00:00"
            android:textColor="@color/pilot_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="154dp"
            android:background="@drawable/pilot_chip_background"
            android:maxWidth="340dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:text="@string/preview_initializing"
            android:textColor="@color/pilot_text_primary"
            android:textSize="13sp" />

        <!-- Compact one-handed control deck for the 480 px-wide Pilot display. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_gravity="bottom"
            android:background="@drawable/preview_bottom_gradient"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/picture_button"
                android:layout_width="112dp"
                android:layout_height="92dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/pilot_action_card_background"
                android:clickable="true"
                android:contentDescription="@string/open_picture_settings"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="7dp"
                android:paddingEnd="7dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_picture_adjustments" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/picture_button_label"
                    android:textColor="@color/pilot_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/picture_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="Auto"
                    android:textColor="@color/pilot_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/record_button"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="2dp"
                android:background="@drawable/record_button_idle"
                android:contentDescription="@string/start_recording"
                android:enabled="false" />

            <TextView
                android:id="@+id/record_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/record_button"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="-4dp"
                android:text="@string/start_recording"
                android:textColor="@color/pilot_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/storage_button"
                android:layout_width="112dp"
                android:layout_height="92dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/pilot_action_card_background"
                android:clickable="true"
                android:contentDescription="@string/change_storage"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="7dp"
                android:paddingEnd="7dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_storage" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/storage_button_label"
                    android:textColor="@color/pilot_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/destination_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/destination_internal_short"
                    android:textColor="@color/pilot_text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/path_text"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
