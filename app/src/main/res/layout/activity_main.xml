<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pilot_black">

    <FrameLayout
        android:id="@+id/preview_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Keep the status-bar views in the hierarchy for PilotStatusBarController,
         while using the original Camera-style full-screen chrome. -->
    <include
        layout="@layout/pilot_status_bar"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_gravity="top"
        android:background="@drawable/native_top_scrim" />

    <View
        android:layout_width="match_parent"
        android:layout_height="176dp"
        android:layout_gravity="bottom"
        android:background="@drawable/native_bottom_scrim" />

    <!-- Original Camera-style top-left GPS/navigation indicator. -->
    <TextView
        android:id="@+id/gps_text"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:drawableStart="@drawable/ic_navigation_arrow"
        android:drawablePadding="4dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxWidth="168dp"
        android:singleLine="true"
        android:text="@string/gps_waiting"
        android:textColor="@color/pilot_text_primary"
        android:textSize="11sp"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="2" />

    <!-- Current exposure / ISO summary in the position used by HDR in the native app. -->
    <TextView
        android:id="@+id/picture_value"
        android:layout_width="152dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:text="Auto"
        android:textColor="#E8FFFFFF"
        android:textSize="19sp"
        android:textStyle="bold"
        android:shadowColor="#E6000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="3" />

    <!-- Visual Pro badge mirrors the native Camera screen. Picture settings are
         opened with the camera button at the lower left. -->
    <TextView
        android:layout_width="58dp"
        android:layout_height="58dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/native_pro_badge_background"
        android:gravity="center"
        android:text="@string/pro_badge"
        android:textColor="#D9FFFFFF"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/record_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="66dp"
        android:background="@drawable/pilot_chip_background"
        android:fontFamily="monospace"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:text="00:00:00"
        android:textColor="@color/pilot_text_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="146dp"
        android:background="@drawable/pilot_chip_background"
        android:maxWidth="340dp"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:text="@string/preview_initializing"
        android:textColor="@color/pilot_text_primary"
        android:textSize="13sp" />

    <!-- Picture-adjustment shortcut: same lower-left position as the native
         Camera app's mode button. -->
    <FrameLayout
        android:id="@+id/picture_button"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/native_round_action_background"
        android:clickable="true"
        android:contentDescription="@string/open_picture_settings"
        android:focusable="true">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_camera_settings" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/record_button"
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="14dp"
        android:background="@drawable/record_button_idle"
        android:contentDescription="@string/start_recording"
        android:enabled="false" />

    <!-- Storage shortcut occupies the native app's lower-right settings slot. -->
    <LinearLayout
        android:id="@+id/storage_button"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/native_round_action_background"
        android:clickable="true"
        android:contentDescription="@string/change_storage"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="9dp"
        android:paddingBottom="5dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_storage" />

        <TextView
            android:id="@+id/destination_button"
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/destination_internal_short"
            android:textColor="@color/pilot_text_primary"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Retained for existing controller logic; the native-style UI does not
         show a caption below the record button. -->
    <TextView
        android:id="@+id/record_caption"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/path_text"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone" />

</FrameLayout>
